# team_name written to results.json
TEAM_NAME=Я и Нурай

# LLM used for evaluation: "gemini" (cloud) or "ollama" (local)
LLM_PROVIDER=ollama

GEMINI_API_KEY=keyhere
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5-9b-gpu
# Thinking models (qwen3.5) can think endlessly and never answer - keep false
OLLAMA_THINK=false
# Context window in tokens: the longest dialogue needs ~7.6k for the prompt alone (Ollama default is 4096)
OLLAMA_NUM_CTX=16384
# Max answer tokens, so a runaway answer stops instead of running forever
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0
# Seconds to wait for one evaluation
OLLAMA_TIMEOUT=600

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
